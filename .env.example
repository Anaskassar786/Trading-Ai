# Trading AI AK — server-side secrets.
# Copy this file to .env and fill in your own values.
# NEVER commit .env. NEVER put these values in frontend code.

# LLM providers
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# Data providers
TWELVE_DATA_API_KEY=
FRED_API_KEY=
NEWS_API_KEY=

# Server
PORT=3000

# TEST MODE: when "true", providers may return clearly-labelled mock data.
# Production default is false. Test data is NEVER mixed with live analysis:
# sessions created in test mode are permanently flagged test_mode=1.
TEST_MODE=false
